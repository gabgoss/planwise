# Agentic Project Management — Project Configuration
plugin_root: "{plugin-root}"
plugin_version: "{plugin-version}"
project:
  name: "{project-name}"
  install_scope: "{install-scope}"  # project, user, or local
  planwise_root: "{planwise-root}"
  # Directories below are relative to planwise_root
  plans_dir: "{plans-dir}"
  backlog_dir: "{backlog-dir}"
  lessons_dir: "{lessons-dir}"
  feedback_dir: "{feedback-dir}"
  index_files:
    plans: "00-Index-Plans.md"
    backlog: "00-Index-Backlog.md"
    lessons: "00-Index-LessonsLearned.md"

# Context window tier — used by all handlers to scale token budgets.
# plan_tier: "pro" (200K) or "max" (1M). Subagents inherit this tier.
# When this block is missing, handlers default to plan_tier=pro / context_window=200000
# for backward compatibility with configs generated before this field existed.
# See references/session-context-budget.md "Context Window Tier" for tier-specific budget tables.
context:
  plan_tier: "{plan-tier}"
  context_window: {context-window}
  # Token Saver budget surface. token_saver toggles the budget engine on/off
  # (default off). The overheads and breakdown below are MEASURED, not
  # hardcoded — `/planwise calibrate` captures a real /context report and
  # writes them in place; a zero/empty value means "not yet calibrated".
  token_saver: {token-saver}
  # token_saver_session_target is a PER-DISPATCHED-WINDOW budget (the hard
  # ceiling for one task-runner subagent), NOT an orchestrator-session target;
  # the orchestrator side is governed by the model floor plus the measured
  # session-length advisory. See references/token-saver-profile.md.
  token_saver_session_target: 150000
  token_saver_runner_overhead: 0      # measured subagent footprint (calibrated)
  token_saver_orchestrator_overhead: 0  # measured orchestrator footprint (calibrated)
  token_saver_context_breakdown: {}   # measured per-category /context breakdown
  token_saver_overhead_measured_on: ""  # ISO date of the last calibration
  # Worst-case per-glob-family rule-injection ceiling; the doctor sweep
  # warns when a single path match would co-inject rule content above this.
  # Default 40000 -- set below the measured ~56,000-tokens-per-affected-
  # session average so a broad-rule-surface install still warns. MUST agree
  # with scripts/doctor_sweeps.py's _INJECTION_CEILING_DEFAULT (a separate
  # fallback site by necessity -- see that constant's own comment).
  token_saver_injection_ceiling: 40000
  # Calibrated session-start /context capture range (min/median/max
  # across captures, right-skewed). Zeros are the uncalibrated sentinel;
  # `/planwise calibrate` overwrites this in place.
  token_saver_session_start_range: {min: 0, median: 0, max: 0}
  # Calibrated estimate of injected path-scoped rule content (the
  # "Memory files" category of a /context capture). 0 is the uncalibrated
  # sentinel.
  token_saver_injected_rules_estimate: 0
  # Gates the orchestrator-window advisory band in reports.
  # measured = surface the measured session-length advisory; off = suppress
  # it (the model floor still enforces regardless of this setting). See
  # references/token-saver-profile.md "Orchestrator-Window Expectation".
  token_saver_orchestrator_advisory: measured
  # Session-length checkpoint (window token count / turn count) read by
  # the run-handler's session-length checkpoint lever. These are
  # CHOSEN OPERATING DEFAULTS derived from the measured accumulation
  # bands -- not a "top-decile onset" threshold.
  token_saver_session_checkpoint: {window: 400000, turns: 194}

abbreviations:
  APP: "Application features"
  BUG: "Bug fixes"
  DOC: "Documentation"
  INFRA: "Infrastructure and DevOps"

lesson_abbreviations:
  TOOL: "Tool usage patterns"
  PERF: "Performance optimization"
  SEC: "Security practices"
  PROC: "Process and workflow"

# Domain bucketing for lessons learned. Consumed by /planwise lessons curate
# and /planwise lessons promote-batch. Curate iterates `decision_tree_order`
# and routes each new lesson into the first bucket whose `triggers` match the
# lesson frontmatter's `technology:` or `domain:` list (OR-combined). If no
# bucket matches, the lesson lands in `default_bucket`.
categorization:
  buckets:
    - id: A
      slug: database
      name: "Database / SQL"
      description: "Lessons that touch the live database, schema, or DDL semantics."
      # Optional. Without `triggers`, this bucket never auto-matches and
      # lessons fall through to `default_bucket`. Activate routing with:
      # triggers:
      #   technology: [sql, mssql, postgres, sqlite, pyodbc]
      #   domain: [DB, SCHEMA]
    - id: B
      slug: code
      name: "Application Code"
      description: "Lessons about language-level patterns, type-checking, lint, runtime behaviour."
      # Optional. `code_bucket: true` switches this bucket's table to the
      # 4-column schema (ID | Title | Module | Severity) instead of the
      # default 3-column schema (ID | Title | Severity):
      # code_bucket: true
      # triggers:
      #   technology: [python, javascript, typescript, pyright, ruff, eslint]
      #   domain: [APP]
    - id: C
      slug: process
      name: "Planwise / Process"
      description: "Lessons about planning, scaffolding, dispatch, signoff, review."
      # Optional. Sub-buckets render as `### {sub_id}. {sub_name}` tables
      # inside this bucket and are first-class scope targets for
      # `/planwise lessons promote-batch --category=C1` (etc.). One level of
      # nesting is supported; sub-buckets inherit the parent's `code_bucket`
      # flag. Each sub-bucket needs `id` and `name`.
      sub_buckets: []  # e.g., - { id: C1, name: "Scaffolding hygiene" }
      # triggers:
      #   domain: [PROC, PMS]
    - id: D
      slug: tooling
      name: "Tooling / Ergonomics"
      description: "Toolchain, shell, notebook, IDE, harness ergonomics."
  decision_tree_order: [A, B, C, D]
  default_bucket: D  # Catch-all when no bucket's triggers match.
  edge_cases_section: true

upgrade:
  # customization_handoff: how /planwise upgrade disposes a customization-bearing
  # installed rule/agent (HAS_UNIQUE, or a subset with tolerated installed-only content):
  #   report          = conservative: preserve in place + .new sidecar; no transfer, no adoption
  #   report+relocate = automated transfer-then-adopt: the customization is verified-written
  #                     to a dormant preservation file under upgrade-transfers/ BEFORE the
  #                     shipped body is adopted (never destroys work; promote the transfer
  #                     file to an active rule interactively when convenient)
  #   report+issue    = same disposition as report; additionally offers a GitHub issue for
  #                     upstream-tagged customizations (interactive only, needs github_issue: true)
  # When this key is ABSENT entirely, the loader falls back to the conservative `report`.
  customization_handoff: report+relocate
  github_issue: false                  # opt-in gh issue for "upstream" entries (interactive only)
  descope_preserve_paths_edits: true   # true = keep today's preserve-on-paths-only-edit behavior; false opts in to removal

feedback:
  # Opt-in. Nothing is ever sent upstream without BOTH this flag AND an
  # explicit interactive confirmation of the exact issue body.
  enabled: false
  # Upstream target passed to the issue-create command's explicit -R flag.
  # NEVER derived from your own git remote — that would file planwise
  # issues in your project's repo.
  repo: "gabgoss/planwise"
  # Include the auto-filled Environment block (plugin version, subcommand).
  # No project file contents, paths, or config values are ever attached.
  include_environment: true

scoring:
  priority_high: 30
  priority_medium: 20
  priority_low: 10
  bug_fix_bonus: 15
  in_progress_bonus: 10
  file_count_bonus: 5
  planning_penalty: -5
  blocks_bonus: 20
  momentum_bonus: 5
  age_bonus_per_week: 1
  age_cap: 12

statuses:
  - NOT_STARTED
  - PLANNING
  - IN_PROGRESS
  - BLOCKED
  - COMPLETE
  - CLOSED

build_commands:
  default: "echo 'Configure build_commands in config.yaml'"
